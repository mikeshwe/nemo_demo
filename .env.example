# NVIDIA API Configuration
# Get your API key from: https://build.nvidia.com
NVIDIA_API_KEY=your_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma_db

# Agent Configuration
MAX_ITERATIONS=10

# OpenTelemetry Configuration (optional)
# Service identification
OTEL_SERVICE_NAME=genaiops-agent
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development

# Export configuration (uncomment to use OTLP export)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp

# Langfuse LLM Observability (optional)
# For local Docker instance, no keys needed (default)
# For Langfuse Cloud, get keys from: https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# OpenLineage Data Lineage (optional)
# Requires Marquez backend: docker run -p 3001:3000 -p 5001:5000 marquezproject/marquez
# Note: Using port 5001 because macOS ControlCenter uses 5000
OPENLINEAGE_ENABLED=false
OPENLINEAGE_URL=http://localhost:5001
OPENLINEAGE_NAMESPACE=genaiops-demo

# Agent Trust Plane (optional)
# Requires OpenLineage to be enabled
# Proactively blocks access to stale/low-quality data before agent uses it
TRUST_PLANE_ENABLED=false
TRUST_PLANE_POLICY_FILE=src/trust_plane/policies.yaml
